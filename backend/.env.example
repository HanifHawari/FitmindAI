# Salin ke backend/.env untuk pengembangan lokal. Jangan commit file .env atau token asli.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database lokal; jalankan backend dari folder backend/.
# Production (Neon, salin URL host "-pooler" apa adanya; awalan postgresql:// otomatis memakai psycopg):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./fitmind.db

# true = paksa mode maintenance untuk semua pengunjung (pemeliharaan terencana).
# Saat database tidak bisa diakses, mode maintenance aktif otomatis.
MAINTENANCE_MODE=false
DATASET_BASE_PATH=../dataset
CHROMA_PERSIST_DIR=./chroma_db

# Isi SESSION_SECRET dengan nilai acak yang panjang sebelum memakai akun.
SESSION_SECRET=

# Kunci layanan opsional untuk fitur terkait.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = matikan "thinking" di AI Chat agar jawaban mulai muncul ±1 detik (default). Kosongkan untuk default model.
GEMINI_THINKING_BUDGET=0
RAPIDAPI_KEY=
FONNTE_TOKEN=
